{
  "expo": {
    "name": "EagleEye",
    "slug": "eagleEye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ]
      },
      "bundleIdentifier": "com.sameer-yasir.eagleEye"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/mobile-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sameer_yasir.eagleEye",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "notification": {
        "icon": "./assets/icon.png",
        "color": "#000000",
        "defaultChannelId": "task-reminders"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "595be4b1-2164-4fed-8bb5-4b026abcba17"
      }
    },
    "owner": "sameer_yasir",
    "plugins": [
      "expo-localization"
    ]
  }
}
