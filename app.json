{
  "expo": {
    "name": "EagleEye",
    "slug": "eagleEye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Allow EagleEye to take project cover photos.",
        "NSPhotoLibraryUsageDescription": "Allow EagleEye to choose project cover photos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      },
      "bundleIdentifier": "com.sameer-yasir.eagleEye"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/mobile-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sameer_yasir.eagleEye",
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": true,
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "965f7868-60cf-4aa7-ac08-a8e4125438de"
      }
    },
    "owner": "hammad6788",
    "plugins": [
      "expo-localization",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EagleEye to choose project cover photos.",
          "cameraPermission": "Allow EagleEye to take project cover photos."
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
