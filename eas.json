{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "NODE_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://api.eagle-eye.ca/",
        "API_URL": "https://api.eagle-eye.ca/"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.eagle-eye.ca/",
        "API_URL": "https://api.eagle-eye.ca/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "NODE_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://api.eagle-eye.ca/",
        "API_URL": "https://api.eagle-eye.ca/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
